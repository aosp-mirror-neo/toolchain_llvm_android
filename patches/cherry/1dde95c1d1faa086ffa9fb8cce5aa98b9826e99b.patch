From 1dde95c1d1faa086ffa9fb8cce5aa98b9826e99b Mon Sep 17 00:00:00 2001
From: Nick Desaulniers <ndesaulniers@google.com>
Date: Wed, 11 Nov 2026 08:51:55 -0800
Subject: [PATCH] [libcxx] mark intentionally unused fields [[maybe_unused]]
 (#241054)

-Wunused-private-field will soon be able to flag fields in instantiated
class templates. Land this in preparation.

Link: #237374
---
 libcxx/include/__memory/compressed_pair.h                       | 2 +-
 .../test/libcxx/containers/associative/map/abi.compile.pass.cpp | 2 +-
 .../test/libcxx/containers/associative/set/abi.compile.pass.cpp | 2 +-
 .../containers/associative/unord.map/abi.compile.pass.cpp       | 2 +-
 .../containers/associative/unord.set/abi.compile.pass.cpp       | 2 +-
 .../test/libcxx/containers/sequences/deque/abi.compile.pass.cpp | 2 +-
 .../containers/sequences/forwardlist/abi.compile.pass.cpp       | 2 +-
 .../test/libcxx/containers/sequences/list/abi.compile.pass.cpp  | 2 +-
 .../containers/sequences/vector.bool/abi.compile.pass.cpp       | 2 +-
 .../libcxx/containers/sequences/vector/abi.compile.pass.cpp     | 2 +-
 libcxx/test/libcxx/strings/basic.string/abi.compile.pass.cpp    | 2 +-
 .../test/libcxx/strings/basic.string/alignof.compile.pass.cpp   | 2 +-
 libcxx/test/libcxx/strings/basic.string/sizeof.compile.pass.cpp | 2 +-
 .../has_unique_object_representations.compile.pass.cpp          | 2 +-
 14 files changed, 14 insertions(+), 14 deletions(-)

diff --git a/libcxx/include/__memory/compressed_pair.h b/libcxx/include/__memory/compressed_pair.h
index 8fa0e64714f2b..08d2aa7774be3 100644
--- a/libcxx/include/__memory/compressed_pair.h
+++ b/libcxx/include/__memory/compressed_pair.h
@@ -77,7 +77,7 @@ inline const bool __is_reference_or_unpadded_object<_Tp&&> = true;
 
 template <class _ToPad, bool _Empty = __is_reference_or_unpadded_object<_ToPad> >
 class __compressed_pair_padding {
-  char __padding_[sizeof(_ToPad) - __datasizeof_v<_ToPad>] = {};
+  [[__maybe_unused__]] char __padding_[sizeof(_ToPad) - __datasizeof_v<_ToPad>] = {};
 };
 
 template <class _ToPad>
diff --git a/libcxx/test/libcxx/containers/associative/map/abi.compile.pass.cpp b/libcxx/test/libcxx/containers/associative/map/abi.compile.pass.cpp
index ca4e9747bc490..18cad9a80b2dd 100644
