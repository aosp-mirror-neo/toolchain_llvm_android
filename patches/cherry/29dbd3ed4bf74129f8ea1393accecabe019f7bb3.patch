From 29dbd3ed4bf74129f8ea1393accecabe019f7bb3 Mon Sep 17 00:00:00 2001
From: yabinc <yabinc@google.com>
Date: Tue, 24 Nov 2026 18:02:24 +0000
Subject: [PATCH] [libc++] Add _LIBCPP_NO_SANITIZE("cfi-unrelated-cast") to
 __shared_ptr_emplace::__get_elem() (#244965)

Commit 7083c0637290 ("[libc++] Remove _LIBCPP_COMPRESSED_PAIR/TRIPLE
from shared_ptr (#200401)") refactored `__shared_ptr_emplace` and
dropped `_LIBCPP_NO_CFI` from `__get_elem()`.

`__shared_ptr_emplace`'s constructor calls
`allocator_traits<_Alloc>::construct(__alloc_, __get_elem(), ...)`,
which runs `reinterpret_cast<__value_type*>(__buffer_)` before
placement-new constructs the object in `__buffer_`. When compiling
polymorphic types with `-fsanitize=cfi-unrelated-cast` (e.g. Android's
CFI builds), Clang instruments that cast with `@llvm.type.test(ptr
undef, ...)` on uninitialized storage, causing runtime traps or
cross-DSO `__cfi_slowpath` segfaults on every
`std::make_shared<PolymorphicType>(...)` call.

Following #220296, annotate `__shared_ptr_emplace::__get_elem()` with
`_LIBCPP_NO_SANITIZE("cfi-unrelated-cast")` to narrowly suppress the
false-positive cast check on uninitialized storage.

Link: https://github.com/llvm/llvm-project/pull/200401
Link: https://github.com/llvm/llvm-project/issues/219306
Link: https://github.com/llvm/llvm-project/pull/220296
---
 libcxx/include/__memory/shared_ptr.h | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/libcxx/include/__memory/shared_ptr.h b/libcxx/include/__memory/shared_ptr.h
index 549b9df9390d..df69ed64fbfc 100644
--- a/libcxx/include/__memory/shared_ptr.h
+++ b/libcxx/include/__memory/shared_ptr.h
@@ -140,7 +140,9 @@ struct _LIBCPP_HIDE_STRUCT_FROM_ABI __shared_ptr_emplace : __shared_weak_count {
     allocator_traits<_Alloc>::construct(__alloc_, __get_elem(), std::forward<_Args>(__args)...);
   }
 
-  _LIBCPP_HIDE_FROM_ABI __value_type* __get_elem() _NOEXCEPT { return reinterpret_cast<__value_type*>(__buffer_); }
+  _LIBCPP_HIDE_FROM_ABI _LIBCPP_NO_SANITIZE("cfi-unrelated-cast") __value_type* __get_elem() _NOEXCEPT {
+    return reinterpret_cast<__value_type*>(__buffer_);
+  }
 
 private:
   _LIBCPP_HIDE_FROM_ABI_VIRTUAL void __on_zero_shared() _NOEXCEPT override {
